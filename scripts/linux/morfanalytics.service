# Service systemd pour morfAnalytics.
#
# Le binaire est INSTALLE dans un dossier fixe (par defaut /opt/morfanalytics),
# independant du clone git. morfdeploy remplace __RUN_USER__, __APP_DIR__ et
# __CONFIG_DIR__.
#
# Trois zones (docs/FILESYSTEM.md) : PROGRAMME dans /opt, CONFIG ADMIN (lecture
# seule) dans /etc, ETAT PERSISTANT (cache SQLite des echantillons) dans /var/lib.
# StateDirectory= fait creer ce dernier par systemd, possede par User= et
# accessible en ecriture, puis l'expose via $STATE_DIRECTORY (dossier de cache par
# defaut du service).

[Unit]
Description=morfAnalytics - moteur d'analyse morfSystem
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_DIR__
# Cree et possede /var/lib/morfsystem/morfanalytics ; expose $STATE_DIRECTORY.
StateDirectory=morfsystem/morfanalytics
ExecStart=__APP_DIR__/morfanalytics --config __CONFIG_DIR__/morfanalytics.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
